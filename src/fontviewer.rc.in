#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @FONTVIEWER_RC_VERSION@
 PRODUCTVERSION @FONTVIEWER_RC_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "1218.io"
            VALUE "FileDescription", "FontViewer plugin for Seer"
            VALUE "FileVersion", "@FONTVIEWER_RC_VERSION_STRING@"
            VALUE "InternalName", "fontviewer"
            VALUE "LegalCopyright", "Copyright (C) 2024 Corey (https://1218.io)"
            VALUE "OriginalFilename", "fontviewer.dll"
            VALUE "ProductName", "FontViewer"
            VALUE "ProductVersion", "@FONTVIEWER_RC_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
